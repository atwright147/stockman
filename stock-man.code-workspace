{
	"folders": [
		{
			"path": ".",
      "name": "Root",
		},
    {
      "path": "backend",
      "name": "Backend",
    },
    {
      "path": "frontend",
      "name": "Frontend",
      "settings": {
        "biome.enabled": true,
        "biome.configurationPath": "../biome.json",
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,

        "editor.codeActionsOnSave": {
          "source.organizeImports.biome": "explicit",
          "source.fixAll.biome": "explicit"
        },

        "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][css][scss][less]": {
          "editor.defaultFormatter": "biomejs.biome",
          "editor.formatOnSave": true,
          "editor.formatOnSaveMode": "file"
        },

        "css.lint.unknownAtRules": "ignore",
        "scss.lint.unknownAtRules": "ignore",
        "less.lint.unknownAtRules": "ignore"
      }
    },
	],
  "settings": {
    "biome.enabled": true,
    "oxc.enable": false,
    "oxc.enable.oxlint": false,
    "oxc.enable.oxfmt": false,
    "eslint.enable": false,
    "eslint.probe": [],
    "prettier.enable": false,
    "biome.configurationPath": "biome.json",
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][css][scss][less]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.formatOnSaveMode": "file"
    },
    "editor.codeActionsOnSave": {
      "source.organizeImports.biome": "explicit",
      "source.fixAll.biome": "explicit"
    },
		"files.exclude": {
      "backend": true,
			"frontend": true,
    },
    "[csharp]": {
      "editor.defaultFormatter": "JakubKozera.csharp-dev-tools"
    },
    // "css.lint.unknownAtRules": "ignore",
    // "scss.lint.unknownAtRules": "ignore",
    // "less.lint.unknownAtRules": "ignore"
  }
}
